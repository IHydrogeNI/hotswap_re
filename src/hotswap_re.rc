#include <windows.h>
#include "version.h"

#define IDI_APP 100

IDI_APP ICON "hotswap_re.ico"

1 24 "hotswap_re.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     HSR_VER_COMMA
PRODUCTVERSION  HSR_VER_COMMA
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Safely hot-swap hardware"
            VALUE "FileVersion",      HSR_VER_STR
            VALUE "InternalName",     "hotswap_re"
            VALUE "OriginalFilename", "hotswap_re.exe"
            VALUE "ProductName",      "hotswap_re"
            VALUE "ProductVersion",   HSR_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
